# -----------------------------------------------------------------------------
# Frontend Environment Variables (.env)
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api

# -----------------------------------------------------------------------------
# Backend Environment Variables / application-dev.properties
# -----------------------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/clothing_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_postgres_password_here

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long_change_in_production
JWT_EXPIRATION_MS=86400000

# Payment Gateway
PAYMENT_API_KEY=your_payment_gateway_api_key
PAYMENT_SECRET=your_payment_gateway_secret

# Google OAuth 2.0 Configuration (Backend)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
OAUTH2_REDIRECT_URL=http://localhost:5173/login

# Object Storage (S3 / Cloudinary / Supabase / Cloudflare R2)
STORAGE_BUCKET=clothing-assets
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key

# -----------------------------------------------------------------------------
# AI & RAG Knowledge Base Configuration
# -----------------------------------------------------------------------------
# Optional: Set an external LLM / Embedding API key (e.g. Gemini, OpenAI, Groq)
# When empty, the system uses built-in high-performance local dense semantic retrieval
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=text-embedding-004

RAG_TOP_K=5
RAG_CHUNK_SIZE=450
RAG_CHUNK_OVERLAP=80

VECTOR_DATABASE_URL=jdbc:postgresql://localhost:5432/clothing_db
