# ==============================================================================
# AI Commerce Agent Microservice — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in real values before running.
# NEVER commit your .env file to source control.
#
# Minimum required for local development:
#   AI_SERVICE_API_KEY, DATABASE_URL
#
# Additional required for production:
#   AI_SERVICE_API_KEY (strong random, 32+ chars), JWT_SECRET,
#   DATABASE_URL (PostgreSQL), CORS_ORIGINS (your production domain)
# ==============================================================================

# --- Application ---
AI_AGENT_ENV=development
LOG_LEVEL=INFO
PORT=8001
HOST=0.0.0.0

# --- CORS ---
# In production, replace with your actual frontend domain(s).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================================================
# SECURITY — REQUIRED IN PRODUCTION
# ==============================================================================

# Shared secret between this service and Spring Boot.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Must be identical to AI_SERVICE_API_KEY in the Spring Boot environment.
# NEVER use "ai-agent-internal-secret-key" or any default value in production.
AI_SERVICE_API_KEY=change-me-generate-with-secrets.token_hex-32

# JWT verification mode: "local" (default) or "delegate"
# "local"    — verify JWT signature here using JWT_SECRET (must match Spring Boot)
# "delegate" — call Spring Boot /api/auth/me (slower, no secret sharing required)
JWT_VERIFICATION_MODE=local

# Required when JWT_VERIFICATION_MODE=local.
# Must be identical to jwt.secret (JWT_SECRET) in the Spring Boot environment.
JWT_SECRET=change-me-must-match-spring-boot-jwt-secret

# ==============================================================================
# LLM PROVIDER
# ==============================================================================

# Provider: mock | openai | groq | gemini | custom_openai
# Use "mock" for offline development (no API key needed).
# Use "custom_openai" for a self-hosted llama.cpp / vLLM server on Colab.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2

# --- Custom / Self-hosted Model Endpoint (Colab + llama.cpp) ---
# Set AI_PROVIDER=custom_openai and fill in these values.
# MODEL_BASE_URL changes every time a new Colab session starts (Quick Tunnel).
# Use the admin endpoint POST /api/admin/model-url to update it dynamically.
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=qwen2.5-7b-instruct
MODEL_TIMEOUT_SECONDS=60

# --- Fallback Provider (optional) ---
# IMPORTANT: Enabling this sends customer messages to a third-party provider.
# Ensure your privacy policy covers this. Leave blank to disable.
FALLBACK_PROVIDER=
FALLBACK_API_KEY=
FALLBACK_MODEL=
FALLBACK_TIMEOUT_SECONDS=30

# ==============================================================================
# SPRING BOOT COMMERCE BACKEND
# ==============================================================================
SPRING_BOOT_BASE_URL=http://localhost:8080

# ==============================================================================
# DATABASE
# ==============================================================================
# Development: file-based SQLite (data persists between restarts)
# Production:  postgresql+asyncpg://user:password@host:5432/ai_agent_db
#
# DO NOT use sqlite+aiosqlite:///:memory: in production.
# All conversation history will be lost on every restart.
DATABASE_URL=sqlite+aiosqlite:///./ai_agent.db

# ==============================================================================
# EMBEDDINGS & RAG
# ==============================================================================
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100

# ==============================================================================
# SAFETY LIMITS & RATE CONTROL
# ==============================================================================
MAX_AGENT_STEPS=10
MAX_TOOL_CALLS=8
MAX_RETRIES=2
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=30
MAX_MESSAGE_LENGTH=2000
MAX_CONTEXT_MESSAGES=20
ENABLE_ORDER_CANCEL_AGENT=true
ENABLE_HUMAN_HANDOFF=true
