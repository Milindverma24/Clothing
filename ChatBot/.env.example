# ==============================================================================
# AI Commerce Agent Microservice - Environment Configuration Template
# ==============================================================================

# Application Environment (development, test, production)
AI_AGENT_ENV=development
LOG_LEVEL=INFO

# Server Configuration
PORT=8001
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated for multiple)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM Provider Configuration
# Supported: "mock", "openai", "gemini", "groq", "anthropic"
AI_PROVIDER=mock
AI_API_KEY=your_llm_api_key_here
AI_MODEL=gpt-4o-mini
AI_TEMPERATURE=0.2

# Embedding Configuration
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small

# Spring Boot Commerce Backend
SPRING_BOOT_BASE_URL=http://localhost:8080
AI_SERVICE_API_KEY=ai-agent-internal-secret-key

# Database Configuration
# Default to SQLite for seamless local startup, or use PostgreSQL:
# postgresql+asyncpg://user:password@localhost:5432/ai_agent
DATABASE_URL=sqlite+aiosqlite:///:memory:

# RAG Knowledge Base
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100

# Safety, Limits & Rate Control
MAX_AGENT_STEPS=10
MAX_TOOL_CALLS=8
MAX_RETRIES=2
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_PER_MINUTE=30
ENABLE_ORDER_CANCEL_AGENT=true
ENABLE_HUMAN_HANDOFF=true
